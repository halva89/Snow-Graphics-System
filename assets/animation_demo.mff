window 800 600
title "MF - Animation Demo 3D"
resizable true
render_mode light
camera true

# Круг: летит вправо-вверх, меняя цвет (красный -> зелёный -> синий), затем обратно
animate circle
    keyframe 0.0
        pos -1.5 -1.0 0.0
        color 1.0 0.0 0.0
    keyframe 2.0
        pos 0.0 1.0 0.0
        color 0.0 1.0 0.0
    keyframe 4.0
        pos 1.5 -1.0 0.0
        color 0.0 0.0 1.0

# Куб: прыгает вверх-вниз по Y (3D)
animate cube
    keyframe 0.0
        pos -1.0 -0.5 1.0
        color 1.0 0.5 0.0
    keyframe 1.5
        pos -1.0 0.5 1.0
        color 0.5 1.0 0.5
    keyframe 3.0
        pos -1.0 -0.5 1.0
        color 1.0 0.5 0.0

# Сфера: летает кругами (3D)
animate sphere
    keyframe 0.0
        pos 1.5 0.0 -1.0
        color 0.2 0.4 1.0
    keyframe 2.0
        pos 0.0 1.5 -1.0
        color 1.0 0.2 0.4
    keyframe 4.0
        pos -1.5 0.0 -1.0
        color 0.4 1.0 0.2
    keyframe 6.0
        pos 0.0 -1.5 -1.0
        color 0.2 0.4 1.0

# Треугольник: вращается по кругу (2D)
animate triangle
    keyframe 0.0
        0.5 -0.5 0.0
        1.0 0.5 0.5
    keyframe 2.0
        -0.5 0.5 0.0
        0.5 1.0 0.5
    keyframe 4.0
        0.5 -0.5 0.0
        0.5 0.5 1.0