# main.frame - появление бордовой рамки вдоль края fov
# Рамка рисуется из левого верхнего угла по часовой стрелке и петляет.
window 900 600
title "main.frame - Frame Draw"
background 0.04 0.01 0.02
camera true
camera_pos 0 0.5 16
camera_target 0 0 0
aa-type none

