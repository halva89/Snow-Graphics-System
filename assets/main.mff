# =============================================================================
# MF — FULL TEST SCENE (always the test scene)
# Shows every shape, textures, physics, shadows and animations.
# Camera is ON: drag with Right Mouse Button to orbit, WASD to move.
# Light source is at (5, 8, 6) — shadows fall to the lower-left-back (on the floor).
# -----------------------------------------------------------------------------
# Sections:
#   1) All shapes x3 versions (plain / textured / checker+physics)
#   2) 2D primitives (triangle, square, circle — no texture support yet)
#   3) Shadow test (tall pillars cast long shadows on the light floor)
#   4) Physics test (bouncing spheres, cube stack, static wall)
#   5) Animation test + obj (animate mesh) test
# =============================================================================

window 1600 900
title "MF — Full Test Scene"
background 0.16 0.16 0.22
camera true
camera_pos 8 9 12
camera_target 0 1.5 -0.5
wireframe true
render_mode light
aa-type msaa4w

# ===== Floor (light colour so shadows read clearly) =====
position 0 -0.1 0
scale 22 0.2 18
cube
1.0
0.82 0.82 0.88


# =============================================================================
# 1) ALL SHAPES x3 VERSIONS
# =============================================================================

# ---- Cube - plain (no texture) ----
position -8 0.5 -3.5
rotation 0 0.4 0.25
cube
1.0
1.0 0.25 0.25

# ---- Cube - with texture (rgb.png). Left side is up. ----
position -6.5 0.5 -3.5
rotation 0 0.4 0.25
cube
1.0
1.0 1.0 1.0
texture "assets/rgb.png" expand

# ---- Cube - checker texture + physics (spawns up high, falls to floor) ----
position -5 4 -3.5
physics: m=1, f=2, p=1
cube
1.0
0.9 0.9 0.9
texture "assets/checker.png" expand

# ---- Sphere - plain (no texture) ----
position -8 0.5 -1.5
sphere
0.5
32
0.25 0.45 1.0

# ---- Sphere - with texture (rgb.png) ----
position -6.5 0.5 -1.5
sphere
0.5
16
1.0 1.0 1.0
texture "assets/rgb.png" fill

# ---- Sphere - checker texture + physics (falls) ----
position -5 4 -1.5
physics: m=1, f=2, p=1
sphere
0.5
20
0.9 0.9 0.9
texture "assets/checker.png" expand


# =============================================================================
# 2) 2D PRIMITIVES (front-facing, no texture support in parser yet)
# =============================================================================

# ---- Triangle ----
position -3 1.4 0.2
triangle
-0.7 -0.5
0.7 -0.5
0.0 0.65
1.0 0.45 0.1

# ---- Square ----
position -1.5 1.4 0.2
square
0.0 0.0 1.3
0.6 0.85 0.95

# ---- Circle ----
position 0.1 1.4 0.2
circle
0.0 0.0 0.65 24
0.1 0.85 1.0


# =============================================================================
# 3) SHADOW TEST (tall pillars cast shadow on the floor)
# =============================================================================
position -1 1.5 -3
scale 0.5 3 0.5
cube
1.0
0.95 0.68 0.2

position 1.5 1.8 -2
scale 0.4 3.6 0.9
cube
1.0
0.3 0.9 0.7


# =============================================================================
# 4) PHYSICS TEST (right side)
# =============================================================================

# ---- Bouncing spheres with different restitution (f) ----
position 3.6 5 -4
physics: m=1, f=0.0, p=0.5
sphere
0.45
16
1.0 0.2 0.2

position 4.6 5 -4
physics: m=1, f=0.5, p=0.5
sphere
0.45
16
1.0 0.75 0.15

position 5.6 5 -4
physics: m=1, f=1.0, p=0.5
sphere
0.45
16
0.15 0.75 1.0

# ---- Cube stack (small pyramid) ----
position 3.7 0.5 -1.2
physics: m=1, f=0.15, p=0.4
cube
0.75
0.55 0.75 0.5

position 4.55 0.5 -1.2
physics: m=1, f=0.15, p=0.4
cube
0.75
0.55 0.75 0.5

position 4.1 1.25 -1.2
physics: m=1, f=0.15, p=0.4
cube
0.75
0.6 0.8 0.5

# ---- Heavy ball thrown into a static wall (m=0 => fixed) ----
position 6.3 2 -1.2
physics: m=5, f=0.8, p=2
sphere
0.5
16
0.1 0.9 0.85

position 8.5 0.5 -2.3
physics: m=0, f=0.0, p=0
cube
0.6
0.30 0.30 0.36

position 8.5 1.2 -2.3
physics: m=0, f=0.0, p=0
cube
0.6
0.30 0.30 0.36

position 8.5 1.9 -2.3
physics: m=0, f=0.0, p=0
cube
0.6
0.30 0.30 0.36


# =============================================================================
# 5) ANIMATION TEST + OBJ LOAD TEST
# (animate <shape> loads built-in shape; animate mesh "file.obj" loads an obj)
# =============================================================================

# ---- Animated cube (moves + changes color) ----
animate cube
keyframe 0.0
pos 2 3 2
color 1.0 0.3 0.3
keyframe 1.0
pos 3 3 2.5
color 0.3 1.0 0.3
keyframe 2.0
pos 2.5 1.8 2
color 0.3 0.5 1.0
keyframe 3.0
pos 2 3 2
color 1.0 1.0 0.2

# ---- Animated sphere (bounce + hue change) ----
animate sphere
keyframe 0.0
pos 4.2 3 2
color 1.0 0.3 1.0
keyframe 1.25
pos 4.2 1.3 2
color 0.3 1.0 1.0
keyframe 2.5
pos 4.2 3 2
color 0.8 0.4 1.0

# ---- Animated 2D circle (moving sprite) ----
animate circle
keyframe 0.0
pos -0.4 2.6 0.6
color 1.0 0.85 0.2
keyframe 1.5
pos 0.6 3.2 0.9
color 0.2 1.0 0.6
keyframe 3.0
pos -0.4 2.6 0.6
color 1.0 0.3 0.8

# ---- OBJ LOAD TEST: animate mesh loads a wavefront .obj ----
animate mesh "assets/cube.obj"
keyframe 0.0
pos 6.0 2.5 -2.5
color 0.9 0.9 0.9
keyframe 1.0
pos 7.0 2.5 -2.5
color 0.9 0.9 0.9
keyframe 2.0
pos 6.0 2.5 -2.5
color 0.9 0.9 0.9