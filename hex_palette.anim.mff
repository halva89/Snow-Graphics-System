# main.frame - HEX Palette Animation
window 800 600
title "HEX Palette Animation"
render_mode heavy
camera true

# Cube at (-2.5, -2.5, 0.0) with color #000000
position -2.5 -2.5 0.0
animate cube
    keyframe 0.0
        pos -2.5 -2.5 0.0
        color 0.00 0.00 0.00

    keyframe 3.0
        pos 0.0 0.0 5.0
        color 0.00 0.00 0.00

    keyframe 6.0
        pos -2.5 -2.5 0.0
        color 0.00 0.00 0.00
}


