# main.frame - HEX Palette Spiral Animation
window 800 600
title "HEX Palette Spiral"
render_mode heavy
camera true

# Cube at (-0.5, -0.5) with color #7B7B00, delay=0.07s
position -0.5 -0.5 0.0
animate cube
    keyframe 0.07
        pos -0.5 -0.5 0.0
        color 0.48 0.48 0.00
    keyframe 3.07
        pos 0.0 0.0 5.0
        color 0.48 0.48 0.00
    keyframe 6.07
        pos -0.5 -0.5 0.0
        color 0.48 0.48 0.00
}

