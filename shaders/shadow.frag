#version 450

// Пасс теней записывает только глубину из shadow.vert. Цветовой аттачмент в
// рендер-пассе — фиктивный (не читается), но некоторые драйверы отказывают в
// создании пайплайна, если фрагментный шейдер не имеет ни одного выхода, — поэтому
// пишем значения в location 0. Глубину это не меняет.
layout(location = 0) out vec4 outColor;

void main() {
    outColor = vec4(0.0);
}